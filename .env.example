# Copia este archivo como .env y complétalo en tu computadora. Nunca lo subas al repo.

# Empresas a revisar (RUC separados por coma)
SUNAT_RUCS=20123456789,10987654321

# Usuario secundario SOL de solo consulta, uno por RUC
SUNAT_20123456789_SOL_USUARIO=
SUNAT_20123456789_SOL_CLAVE=

# Correo donde llegan las alertas de SUNAT (IMAP). En Gmail usa una "contraseña de aplicación".
SUNAT_IMAP_HOST=imap.gmail.com
SUNAT_IMAP_USUARIO=
SUNAT_IMAP_CLAVE=
SUNAT_IMAP_CARPETA=INBOX

# Carpeta de salida (PDF, textos y base SQLite)
SUNAT_SALIDA=salida
